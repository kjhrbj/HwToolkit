<root>
	<context tag="CreateRbe3Ctx">
        <listener tag="unpost" eventname="ContextUnPost" command="hwctx OnUnpost"/>
        <listener tag="proceed" eventname="AutoProceed" command="hwctx AutoProceed"/>
		<guidebar tag="gb">
            <item tag="options" image="fdmTextToolbarDropdownStrip-16.png" indicator="always">
                <popup tag="pp">
                    <options tag="op">
                        <item tag="Name" label="Component Name:" type="string" default="AutoRbe3" state="normal" optionname="name" />
                        <item tag="weight" label=" Auto Weight" type="boolcheck" default="1" state="normal" optionname="auto_weight" />
                    </options>
                </popup>
            </item>

            <item tag="selelems" type="entityselector" selectionname="ElemsSelector" entitytypes="Element" defaultentity="Element" hmselectionmode="append"/>

            <item tag="ok" image="toolbarActionOKStrip-16.png" command="hwctx ok"/>
            <item tag="cancel" image="toolbarActionCancelStrip-16.png" command="hwctx cancel"/>
		</guidebar>
	</context>
</root>